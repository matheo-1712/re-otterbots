# Copier ce fichier vers examples/.env — il est ignoré par git.

# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=

# Serveur de test : les commandes de guilde apparaissent instantanément.
# Laisser vide pour enregistrer en global (~1 h de propagation).
DISCORD_GUILD_ID=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
