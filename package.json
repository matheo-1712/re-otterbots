{
  "name": "re-otterbots",
  "version": "0.1.0",
  "description": "Moteur pour construire des bots Discord",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "example": "tsx watch --env-file=examples/.env examples/basic-bot/index.ts",
    "example:deploy": "tsx --env-file=examples/.env examples/basic-bot/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --project examples/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run typecheck:examples && npm run lint && npm run format:check && npm run test",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "discord.js": "^14.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "discord.js": "^14.16.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "framework",
    "typescript"
  ],
  "author": "matheo-1712",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheo-1712/re-otterbots.git"
  },
  "bugs": {
    "url": "https://github.com/matheo-1712/re-otterbots/issues"
  },
  "homepage": "https://github.com/matheo-1712/re-otterbots#readme",
  "license": "MIT"
}
