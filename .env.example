BOT_TOKEN=

# Fichier YAML de configuration du bot (créé s'il n'existe pas). Vide : otterbots.yml à la racine du projet
CONFIG_FILE=
# Fichier YAML des bots distants pilotés par l'interface web. Vide : panel.yml à la racine du projet
PANEL_CONFIG_FILE=

# Interface web de configuration (voir docs/web.md)
# false : l'interface n'est pas lancée
WEB_PANEL=true
WEB_PORT=3000
# 127.0.0.1 : accessible uniquement depuis cette machine. Toute autre adresse exige WEB_PASSWORD
WEB_HOST=127.0.0.1
WEB_PASSWORD=

# API du bot, pour le configurer depuis un panneau lancé sur un autre service
# Lancée seulement si API_TOKEN est défini (16 caractères minimum)
API_TOKEN=
API_PORT=4000
# 0.0.0.0 pour être joignable depuis les autres services
API_HOST=127.0.0.1
